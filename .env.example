# Copy this file to .env and fill in values.

# --- LLM provider: gemini (default) or openai ---
LLM_PROVIDER=gemini

# Google Gemini (free key: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here
# Prefer flash-lite on free tier (higher quota, usually less overload)
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Use local sentence-transformers for embeddings (recommended with Gemini free tier)
USE_LOCAL_EMBEDDINGS=true
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG / graph settings
TOP_K=5
RELEVANCE_THRESHOLD=0.5
MAX_RETRIEVAL_RETRIES=2
MAX_GENERATION_RETRIES=2
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Paths (relative to project root)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
VECTOR_STORE_DIR=data/vector_store
TRACES_DIR=data/traces
CHECKPOINT_DB=data/traces/checkpoints.sqlite
